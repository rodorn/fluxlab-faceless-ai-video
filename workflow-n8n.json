{
  "name": "FluxLab faceless AI video (TomStyl)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9,17 * * *" }
          ]
        }
      },
      "id": "b1b1b1b1-0000-4000-8000-000000000001",
      "name": "Harmonogram 2x dziennie",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300],
      "notes": "09:00 i 17:00 czasu serwera. Dla 1x dziennie ustaw '0 9 * * *'."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "topic",
              "value": "porady stylizacyjne dla mezczyzn",
              "type": "string"
            },
            {
              "id": "t2",
              "name": "projectDir",
              "value": "/opt/faceless-ai-video",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1b1b1b1-0000-4000-8000-000000000002",
      "name": "Parametry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "command": "=cd {{ $json.projectDir }} && python run.py --topic \"{{ $json.topic }}\""
      },
      "id": "b1b1b1b1-0000-4000-8000-000000000003",
      "name": "Pipeline (script->voice->captions->assemble->publish dry-run)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [680, 300],
      "notes": "Tryb demo (dry-run). Aby realnie publikowac dodaj flage --publish i tokeny w env n8n."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "b1b1b1b1-0000-4000-8000-000000000004",
      "name": "Sukces?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {},
      "id": "b1b1b1b1-0000-4000-8000-000000000005",
      "name": "OK (wideo w out/)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1160, 200]
    },
    {
      "parameters": {},
      "id": "b1b1b1b1-0000-4000-8000-000000000006",
      "name": "Alert bledu",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1160, 400],
      "notes": "Podłącz tu powiadomienie (Slack/Discord/email) o nieudanym renderze."
    }
  ],
  "connections": {
    "Harmonogram 2x dziennie": {
      "main": [[{ "node": "Parametry", "type": "main", "index": 0 }]]
    },
    "Parametry": {
